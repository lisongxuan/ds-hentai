{
  "buildCommand": "npm run build:demo",
  "outputDirectory": "demo",
  "installCommand": "npm install",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=60" }
      ]
    }
  ]
}
