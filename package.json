{
  "name": "ds-hentai",
  "version": "0.7.0",
  "description": "ExHentai.org-inspired dark gallery skin for the DeepSeek Harness Web GUI: gallery chrome, optional native sidebar, mutually exclusive skin/native composer, per-option [...] panels, and reversible settings.",
  "license": "MIT",
  "author": "ds-hentai contributors",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lisongxuan/ds-hentai.git"
  },
  "homepage": "https://github.com/lisongxuan/ds-hentai#readme",
  "bugs": {
    "url": "https://github.com/lisongxuan/ds-hentai/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "skin",
    "exhentai",
    "dark-ui",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "check": "node scripts/check.mjs",
    "check:demo": "node scripts/check-demo.mjs",
    "preview": "npm run build:demo && node scripts/serve-demo.mjs",
    "capture": "node scripts/capture-preview.mjs",
    "test": "npm run build && npm run check && npm run test:l1 && npm run build:demo && npm run check:demo",
    "test:l1": "node --test --test-timeout=30000 test/compat/l1.test.mjs",
    "test:compat": "node scripts/probe-dsh.mjs",
    "test:compat:all": "node scripts/compat-matrix.mjs --write",
    "test:e2e": "node scripts/e2e-dsh.mjs",
    "test:e2e:latest": "node scripts/e2e-dsh.mjs --version latest",
    "test:e2e:npm": "node scripts/e2e-dsh.mjs --version latest --plugin ds-hentai@0.7.0",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.9",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
